# =============================================================================
# prompt-n-click — Environment Configuration
# Copy this file to .env and fill in values for your machine.
# =============================================================================

# ------------------------------------------------------------------------------
# LLM (llama.cpp) — path to your local GGUF model folder
# This directory is mounted read-only into the llama.cpp container.
# Example (Windows): LLM_MODELS_PATH=C:/AI/models
# Example (Linux):   LLM_MODELS_PATH=/home/user/ai/models
# ------------------------------------------------------------------------------
LLM_MODELS_PATH=C:/path/to/your/llm/models

# ------------------------------------------------------------------------------
# ComfyUI — path to your ComfyUI models directory
# Must contain the Stable Diffusion checkpoints and VAE you want to use.
# Example (Windows): COMFYUI_MODELS_PATH=C:/AI/ComfyUI/models
# Example (Linux):   COMFYUI_MODELS_PATH=/home/user/ai/ComfyUI/models
# ------------------------------------------------------------------------------
COMFYUI_MODELS_PATH=C:/path/to/your/comfyui/models
